# Copie para .env (cp .env.example .env). Nunca faça commit do .env.
# Valores abaixo servem só para ambiente local. As portas só aceitam conexões deste computador.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Portas no seu computador. Mude se alguma estiver ocupada.
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# IA (Claude). Sem chave e modelo a análise não roda; o resto do app funciona.
# Nunca faça commit da chave. O modelo será definido depois.
# Padrão de reserva: a líder pode cadastrar a chave e escolher o modelo em Configurações.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Limite de tamanho da transcrição aceita para análise (em caracteres).
TRANSCRIPT_MAX_CHARS=200000

# Login (Keycloak). O Bonsai usa o Keycloak da empresa, no reino "bonsai".
# Sem estes valores a API sobe, mas o login avisa que falta configurar.
# NUNCA faça commit do segredo nem da chave.
KEYCLOAK_ISSUER=https://auth.coolify.radar.farmarcas.com.br/realms/bonsai
KEYCLOAK_CLIENT_ID=bonsai-web
# Painel do Keycloak > reino bonsai > Clients > bonsai-web > Credentials > Client secret.
KEYCLOAK_CLIENT_SECRET=
# Chave que cifra a sessão (32 bytes em base64). Gere com: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
# Endereço pelo qual o navegador abre a tela (o mesmo cadastrado no Keycloak).
APP_BASE_URL=http://localhost:3000

